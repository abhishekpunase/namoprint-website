# ── Switch API target (restart `npm run dev` after changing) ──
# true  = Vite proxy to VITE_DEV_API_TARGET (no CORS on localhost)
# false = direct calls to VITE_PROD_API_BASE_URL
VITE_IS_DEV=true

# Used when VITE_IS_DEV=true — Vite proxies /api and /uploads here
VITE_DEV_API_TARGET=http://127.0.0.1:5000
# Remote backend while isDev (still proxied, avoids CORS):
# VITE_DEV_API_TARGET=https://api.namoprints.in

# Used when VITE_IS_DEV=false — all fetch() calls go here directly
VITE_PROD_API_BASE_URL=https://api.namoprints.in/api

# Public site URL for SEO, canonical links, Open Graph, sitemap (no trailing slash)
VITE_SITE_URL=https://www.namoprints.in
