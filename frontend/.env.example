# Build-time variables (set before `npm run build`)
# Hosted API (frontend talks to a remote backend):
# VITE_API_BASE_URL=http://98.84.114.139/api
# Same-origin deploy (recommended for production):
VITE_API_BASE_URL=/api
# Separate API host:
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# Dev proxy + upload image origin (dev only — not used in production build).
# Origin only — not /api or /api/health.
VITE_DEV_API_TARGET=http://127.0.0.1:5000

# Public site URL for SEO, canonical links, Open Graph, sitemap (no trailing slash)
VITE_SITE_URL=https://namoprint.com
