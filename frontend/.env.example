# Build-time variables (set before `npm run build`)
# Same-origin deploy (recommended):
VITE_API_BASE_URL=/api
# Separate API host:
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# Dev proxy target (dev only — not used in production build)
VITE_DEV_API_TARGET=http://127.0.0.1:5000

# Public site URL for SEO, canonical links, Open Graph, sitemap (no trailing slash)
VITE_SITE_URL=https://namoprint.com
