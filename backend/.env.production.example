# Copy to backend/.env on your production server
IS_DEV=false

PORT=5000

PROD_API_BASE_URL=https://api.namoprints.in
PROD_CLIENT_URL=https://www.namoprints.in,https://namoprints.in,https://ft.namoprints.in
PROD_PASSWORD_RESET_URL=https://www.namoprints.in/reset-password
PROD_LOCAL_UPLOAD_PUBLIC_URL=https://api.namoprints.in/uploads

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/printingwatch?retryWrites=true&w=majority
USE_MEMORY_MONGO=false
SEED_ON_START=false
SEED_DEV_USERS=false
SEED_DEV_CATALOG=false

JWT_ACCESS_SECRET=replace_with_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_min_32_chars
COOKIE_SECRET=replace_with_long_random_cookie_secret_min_32_chars
ADMIN_SETUP_SECRET=replace_with_long_random_admin_setup_secret

JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=40
MAX_IMAGE_MB=25

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Namo Print <no-reply@namoprint.com>"
