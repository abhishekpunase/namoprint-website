# Copy to backend/.env on your production server
NODE_ENV=production
PORT=5000

# Public site URL (no trailing slash)
API_BASE_URL=https://namoprint.com
CLIENT_URL=https://namoprint.com,https://www.namoprint.com
PASSWORD_RESET_URL=https://namoprint.com/reset-password
LOCAL_UPLOAD_PUBLIC_URL=https://namoprint.com/uploads

# MongoDB Atlas (required — do NOT use USE_MEMORY_MONGO in production)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/printingwatch?retryWrites=true&w=majority
USE_MEMORY_MONGO=false
SEED_ON_START=false
SEED_DEV_USERS=false
SEED_DEV_CATALOG=false

# Strong secrets — generate random 48+ character strings
JWT_ACCESS_SECRET=replace_with_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_min_32_chars
COOKIE_SECRET=replace_with_long_random_cookie_secret_min_32_chars
ADMIN_SETUP_SECRET=replace_with_long_random_admin_setup_secret

JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=40
MAX_IMAGE_MB=25

# Optional integrations
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Namo Print <no-reply@namoprint.com>"
